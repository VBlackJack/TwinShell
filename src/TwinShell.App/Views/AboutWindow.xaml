<Window x:Class="TwinShell.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="About TwinShell"
        Height="600" Width="550"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Icon="/Assets/twinshell-icon.png"
        ResizeMode="NoResize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="0" GlassFrameThickness="-1" CornerRadius="8" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Title Style -->
        <Style x:Key="TitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSize.XXL}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Subtitle Style -->
        <Style x:Key="SubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSize.MD}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSize.MD}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Margin" Value="{StaticResource Spacing.MD}"/>
        </Style>

        <!-- Info Style -->
        <Style x:Key="InfoStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Base}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Feature Style -->
        <Style x:Key="FeatureStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSize.SM}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>

        <!-- Copyright Style -->
        <Style x:Key="CopyrightStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSize.2XS}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="{StaticResource Spacing.SM}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Glass Title Bar -->
        <Grid Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="About TwinShell" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.9"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="CloseButton" Click="CloseButton_Click" Style="{DynamicResource WindowCloseButtonStyle}" ToolTip="Close">
                    <Path Data="M 0 0 L 10 10 M 0 10 L 10 0" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1"/>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="{StaticResource Spacing.XXL}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
        <StackPanel Grid.Row="0">
            <!-- App Icon/Logo -->
            <Border Width="100" Height="100"
                    Margin="{StaticResource Spacing.MD}"
                    CornerRadius="{StaticResource Radius.LG}"
                    HorizontalAlignment="Center">
                <Border.Clip>
                    <RectangleGeometry Rect="0,0,100,100" RadiusX="20" RadiusY="20"/>
                </Border.Clip>
                <Image Source="/Assets/twinshell-icon.png"
                       Width="100"
                       Height="100"
                       Stretch="Uniform"/>
            </Border>

            <TextBlock Text="TwinShell" Style="{StaticResource TitleStyle}"/>
            <TextBlock x:Name="VersionText"
                       FontSize="{StaticResource FontSize.Base}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="{StaticResource Spacing.SM}"/>
            <TextBlock Text="PowerShell &amp; Bash Command Manager"
                       Style="{StaticResource SubtitleStyle}"
                       Margin="0,0,0,4"/>
            <TextBlock Text="For System Administrators"
                       Style="{StaticResource SubtitleStyle}"/>
        </StackPanel>

        <!-- Content Section -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="{StaticResource Spacing.MD}">
            <StackPanel>
                <!-- Description -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Base}"
                        Padding="{StaticResource Spacing.MD}"
                        Margin="{StaticResource Spacing.Base}">
                    <TextBlock Style="{StaticResource InfoStyle}">
                        <Run Text="TwinShell is a professional tool designed to simplify system command management and execution. Whether you work on Windows or Linux, TwinShell centralizes your frequent commands and lets you execute them quickly."/>
                    </TextBlock>
                </Border>

                <!-- Author Info -->
                <TextBlock Text="Development" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Base}"
                        Padding="{StaticResource Spacing.MD}"
                        Margin="{StaticResource Spacing.Base}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource InfoStyle}">
                            <Run Text="Author: " FontWeight="SemiBold"/>
                            <Run Text="Julien Bombled"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Features -->
                <TextBlock Text="Key Features" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Base}"
                        Padding="{StaticResource Spacing.MD}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource FontSize.SM}" Foreground="{DynamicResource SuccessBrush}" Margin="{StaticResource Spacing.SM}"/>
                            <TextBlock Text="PowerShell and Bash command library" Style="{StaticResource FeatureStyle}" Margin="0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Direct execution with parameter filling" Style="{StaticResource FeatureStyle}" Margin="0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Complete execution history" Style="{StaticResource FeatureStyle}" Margin="0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Category and tag management" Style="{StaticResource FeatureStyle}" Margin="0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Batch mode for multiple executions" Style="{StaticResource FeatureStyle}" Margin="0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Advanced search and filtering" Style="{StaticResource FeatureStyle}" Margin="0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Light/Dark themes" Style="{StaticResource FeatureStyle}" Margin="0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Command import/export" Style="{StaticResource FeatureStyle}" Margin="0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Cross-platform support" Style="{StaticResource FeatureStyle}" Margin="0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

            <!-- Footer Section -->
            <StackPanel Grid.Row="2" Margin="{StaticResource Spacing.MD}">
                <TextBlock Text="© 2026 TwinShell Project" Style="{StaticResource CopyrightStyle}"/>
                <TextBlock Text="All rights reserved" Style="{StaticResource CopyrightStyle}" Margin="{StaticResource Spacing.MD}"/>

                <!-- Close Button -->
                <Button Content="Close"
                        Click="CloseButton_Click"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Center"
                        Padding="{StaticResource Spacing.Base}"
                        MinWidth="120"
                        MinHeight="44"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
