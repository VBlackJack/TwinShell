<Window x:Class="TwinShell.App.Views.ConflictResolutionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Resolve Sync Conflicts"
        Height="550" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Icon="/Assets/twinshell-icon.png"
        ResizeMode="CanResize"
        MinHeight="400" MinWidth="500">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="8" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Header Style -->
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Description Style -->
        <Style x:Key="DescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>

        <!-- Conflict Item Style -->
        <Style x:Key="ConflictItemStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Entity Name Style -->
        <Style x:Key="EntityNameStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Entity Type Style -->
        <Style x:Key="EntityTypeStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Timestamp Style -->
        <Style x:Key="TimestampStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Glass Title Bar -->
        <Grid Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Resolve Sync Conflicts" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.9"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinimizeButton" Click="MinimizeButton_Click" Style="{DynamicResource WindowButtonStyle}" ToolTip="Minimize">
                    <Path Data="M 0 0 H 10" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1" VerticalAlignment="Center"/>
                </Button>
                <Button x:Name="MaximizeButton" Click="MaximizeButton_Click" Style="{DynamicResource WindowButtonStyle}" ToolTip="Maximize">
                    <Path Data="M 0 0 H 10 V 10 H 0 Z" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1" Fill="Transparent"/>
                </Button>
                <Button x:Name="CloseButton" Click="CloseButton_Click" Style="{DynamicResource WindowCloseButtonStyle}" ToolTip="Close">
                    <Path Data="M 0 0 L 10 10 M 0 10 L 10 0" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1"/>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="24"
                           Foreground="{DynamicResource WarningBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <TextBlock Text="Sync Conflicts Detected" Style="{StaticResource HeaderStyle}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Style="{StaticResource DescriptionStyle}"
                       Text="The following conflicts were detected during synchronization. Please choose how to resolve each conflict."/>
        </StackPanel>

        <!-- Conflicts List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Data Conflicts Section -->
                <TextBlock x:Name="DataConflictsHeader"
                           Text="Data Conflicts"
                           Style="{StaticResource SectionHeaderStyle}"
                           Visibility="Collapsed"/>
                <ItemsControl x:Name="DataConflictsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ConflictItemStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Entity Info -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                                        <TextBlock Text="{Binding EntityName}" Style="{StaticResource EntityNameStyle}"/>
                                        <TextBlock Text="{Binding EntityType, StringFormat='({0})'}" Style="{StaticResource EntityTypeStyle}"/>
                                    </StackPanel>

                                    <!-- Timestamps -->
                                    <Grid Grid.Row="1" Margin="0,8,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Local Version" Style="{StaticResource TimestampStyle}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding LocalModifiedAt, StringFormat='{}{0:g}'}" Style="{StaticResource TimestampStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Remote Version" Style="{StaticResource TimestampStyle}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding RemoteModifiedAt, StringFormat='{}{0:g}'}" Style="{StaticResource TimestampStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Resolution Options -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                                        <RadioButton Content="Keep Local"
                                                     GroupName="{Binding EntityId}"
                                                     IsChecked="{Binding IsKeepLocalSelected}"
                                                     Margin="0,0,16,0"
                                                     VerticalAlignment="Center"/>
                                        <RadioButton Content="Use Remote"
                                                     GroupName="{Binding EntityId}"
                                                     IsChecked="{Binding IsUseRemoteSelected}"
                                                     Margin="0,0,16,0"
                                                     VerticalAlignment="Center"/>
                                        <RadioButton Content="Skip"
                                                     GroupName="{Binding EntityId}"
                                                     IsChecked="{Binding IsSkipSelected}"
                                                     VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Git Merge Conflicts Section -->
                <TextBlock x:Name="MergeConflictsHeader"
                           Text="Git Merge Conflicts"
                           Style="{StaticResource SectionHeaderStyle}"
                           Visibility="Collapsed"/>
                <Border x:Name="MergeConflictsPanel"
                        Style="{StaticResource ConflictItemStyle}"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                                   Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="The following files have Git merge conflicts that must be resolved manually:"/>
                        </TextBlock>
                        <ItemsControl x:Name="MergeConflictsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Text="&#xE7C3;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource ErrorBrush}"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontFamily="Consolas"
                                                   FontSize="12"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Background="{DynamicResource WarningBackgroundBrush}"
                                BorderBrush="{DynamicResource WarningBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12"
                                Margin="0,12,0,0">
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}">
                                <Run FontWeight="SemiBold" Text="Note:"/>
                                <Run Text="Please resolve these conflicts manually using your preferred Git tool (VS Code, Git GUI, etc.) and then retry the sync operation."/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Click="CancelButton_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="16,10"
                    MinWidth="100"
                    MinHeight="40"
                    Margin="0,0,12,0"/>
            <Button x:Name="ApplyButton"
                    Content="Apply Resolutions"
                    Click="ApplyButton_Click"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Padding="16,10"
                    MinWidth="140"
                    MinHeight="40"/>
        </StackPanel>
        </Grid>
    </Grid>
</Window>
