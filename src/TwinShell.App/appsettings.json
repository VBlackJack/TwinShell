{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "TwinShell": "Information"
    }
  },
  "Performance": {
    "SearchLatencyTargetMs": 200,
    "UiLoadLatencyTargetMs": 500,
    "DatabaseQueryWarningMs": 5000,
    "CommandExecutionDefaultTimeoutSeconds": 30
  },
  "Backup": {
    "AutoBackupIntervalHours": 24,
    "RetentionDays": 30,
    "MaxBackupSizeMb": 100
  },
  "Resilience": {
    "HttpTimeoutSeconds": 30,
    "GitTimeoutMinutes": 5,
    "DatabaseTimeoutSeconds": 10,
    "MaxRetryAttempts": 3
  }
}
